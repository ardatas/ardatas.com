{
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "esbuild": "0.28.2",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-jinja-template": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "watch:tailwind": "tailwindcss -i ./src/index.css -o ./dist/index.css --watch",
    "watch:html": "nodemon --watch src --watch components --watch lib -e '*' --exec 'uv run python src/build.py --output dist'",
    "flask-dev": "uv run python -m flask --app src/dev-server.py --debug run --port 8000",
    "dev": "concurrently \"pnpm watch:html\" \"pnpm watch:tailwind\" \"pnpm flask-dev\"",
    "build": "./build.sh",
    "typecheck": "tsc --noEmit",
    "preview": "npx serve dist/"
  }
}
